<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <com.example.myapplication.widget.widget.ParticleAnimationView
        android:id="@+id/emoji_view"
        android:layout_width="400dp"
        android:layout_height="400dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.example.myapplication.widget.MaterialLoadingButton
        android:id="@+id/btnOpenGallery"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:background="@color/black"
        android:text="Open Gallery"
        app:buttonTextColor="@color/white"
        app:buttonTextSize="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:progressBarColor="@color/white"
        app:progressBarSize="20dp" />

    <com.example.myapplication.widget.MaterialLoadingButton
        android:id="@+id/btnOpenGallery2"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:background="@color/black"
        android:text="Open Gallery"
        app:buttonTextColor="@color/white"
        android:layout_marginTop="200dp"
        app:buttonTextSize="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:progressBarColor="@color/white"
        app:progressBarSize="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>