<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <TextView
        android:id="@+id/text_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_curtain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="窗帘" />

            <Button
                android:id="@+id/btn_char_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="字母列表" />

            <Button
                android:id="@+id/btn_direction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="方向键" />

            <Button
                android:id="@+id/btn_gesture_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="手势密码" />

            <Button
                android:id="@+id/btn_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="loading" />

            <Button
                android:id="@+id/btn_mask"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="引导蒙版" />

            <Button
                android:id="@+id/btn_emoji_flower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Emoji Flower" />

            <Button
                android:id="@+id/btn_viewpager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="view_pager" />


            <com.example.myapplication.custom_page.IdProfileHeaderView
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <com.example.myapplication.custom_page.UserOnlineStatusHeaderView
                android:id="@+id/user_online_status_header_view"
                android:layout_width="28dp"
                android:layout_height="28dp" />




            <TextView
                android:id="@+id/tv_chat_template_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:lineHeight="16sp"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="110912cvknlskdhgw110912cvknlskdhgw110912cvknlskdhgw sldjnkervhadv "
                android:textColor="@color/black"
                android:textFontWeight="500"
                android:textSize="22dp"
                app:layout_constraintEnd_toEndOf="@+id/iv_chat_template_image"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toEndOf="@+id/iv_chat_template_check"
                app:layout_constraintTop_toBottomOf="@+id/iv_chat_template_image"
                app:layout_constraintWidth_max="74dp" />


            <Button
                android:id="@+id/btn_flow_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="流布局" />


        </LinearLayout>
    </ScrollView>
</TableLayout>